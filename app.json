{
  "expo": {
    "name": "CurveLead",
    "slug": "curvelead-mobile",
    "scheme": "curvelead",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/curvelead-icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f0f9ff",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#f0f9ff",
      "hidden": false
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.curvelead.mobile"
    },
    "android": {
      "package": "com.curvelead.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/curvelead-adaptive-icon.png",
        "backgroundColor": "#031d50"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#ffffff",
            "image": "./assets/splash-transparent.png"
          },
          "image": "./assets/splash-transparent.png"
        }
      ]
    ],
    "extra": {
      "apiUrlDev": "https://curvelead.com/api",
      "apiUrlProd": "https://curvelead.com/api",
      "facebookAppId": "1551778202757963",
      "router": {},
      "eas": {
        "projectId": "1b2165d6-eb2a-411b-b7e8-9b0843cdfa82"
      }
    }
  }
}
